{
  "description": "Apache Magpie agent guard",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/tools/agent-guard/src/agent_guard/__init__.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
