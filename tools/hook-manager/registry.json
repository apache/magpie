{
  "$comment": "Hook-manager adapters for the secure agent setup. The contract is tools/hook-manager/README.md; tools/dev/sync-hook-managers.py validates this file and writes it into the scripts that implement the contract.",
  "adapters": {
    "cargo-husky": {
      "language": "Rust",
      "upstream": "https://github.com/rhysd/cargo-husky",
      "detect": {
        "config_files": [],
        "nested": false,
        "hook_marker": "cargo-husky"
      },
      "install": {
        "strategy": "none"
      }
    },
    "git-build-hook": {
      "language": "Java",
      "upstream": "https://github.com/rudikershaw/git-build-hook",
      "detect": {
        "config_files": [
          "pom.xml"
        ],
        "nested": true,
        "hook_marker": "git-build-hook"
      },
      "install": {
        "strategy": "none"
      }
    },
    "git-code-format-maven-plugin": {
      "language": "Java",
      "upstream": "https://github.com/Cosium/git-code-format-maven-plugin",
      "detect": {
        "config_files": [
          "pom.xml"
        ],
        "nested": true,
        "hook_marker": "git-code-format-maven-plugin"
      },
      "install": {
        "strategy": "none"
      }
    },
    "prek": {
      "language": "Rust",
      "upstream": "https://github.com/j178/prek",
      "detect": {
        "config_files": [
          "prek.toml",
          ".pre-commit-config.yaml",
          ".pre-commit-config.yml"
        ],
        "nested": true,
        "hook_marker": "prek"
      },
      "install": {
        "subcommand": "install",
        "strategy": "git-dir-flag",
        "flag": "--git-dir"
      },
      "home": {
        "env": "PREK_HOME",
        "default": "~/.cache/prek",
        "sandbox": "~/.cache/prek-sandbox",
        "host": "~/.local/share/prek-host",
        "expands_tilde": true
      }
    },
    "overcommit": {
      "language": "Ruby",
      "upstream": "https://github.com/sds/overcommit",
      "detect": {
        "config_files": [
          ".overcommit.yml"
        ],
        "nested": false,
        "hook_marker": "overcommit"
      },
      "install": {
        "subcommand": "--install",
        "aliases": [
          "-i"
        ],
        "strategy": "hooks-path-env",
        "runtime_env": true
      }
    },
    "simple-git-hooks": {
      "language": "JavaScript",
      "upstream": "https://github.com/toplenboren/simple-git-hooks",
      "detect": {
        "config_files": [
          "package.json",
          ".simple-git-hooks.json",
          ".simple-git-hooks.js",
          ".simple-git-hooks.cjs",
          "simple-git-hooks.json",
          "simple-git-hooks.js",
          "simple-git-hooks.cjs"
        ],
        "nested": false,
        "hook_marker": "simple-git-hooks"
      },
      "install": {
        "strategy": "none"
      }
    }
  }
}
