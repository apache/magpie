{
  "has_keys_import": {
    "type": "regex",
    "field": "paste_recipe",
    "pattern": "gpg\\d*[^\\n]*--import(?![-\\w])"
  },
  "has_sig_verify": {
    "type": "regex",
    "field": "paste_recipe",
    "pattern": "gpg\\d*[^\\n]*--verify\\b"
  },
  "has_asc_signature": {
    "type": "regex",
    "field": "paste_recipe",
    "pattern": "\\.asc\\b"
  }
}
