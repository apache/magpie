{
  "no_at_mentions": {
    "type": "regex",
    "field": "report",
    "pattern": "(^|[^\\w/\\[`])@[A-Za-z0-9][A-Za-z0-9-]*",
    "negate": true
  },
  "uses_verified_name": {
    "type": "contains",
    "field": "report",
    "substring": "Kiran Shah"
  },
  "marks_capped_as_minimum": {
    "type": "regex",
    "field": "report",
    "pattern": "at least|minimum|lower bound|\\u2265|>=",
    "flags": "i"
  },
  "has_surfacing_note": {
    "type": "field_true",
    "field": "has_surfacing_note"
  },
  "no_floors_met_count": {
    "type": "regex",
    "field": "report",
    "pattern": "floors met|\\b\\d+ of \\d+ floors|ready to nominate|strong(est)? candidate",
    "flags": "i",
    "negate": true
  },
  "listed_alphabetically": {
    "type": "regex",
    "field": "report",
    "pattern": "(?s)amir-docs.*zoe-builder"
  },
  "no_threshold_column": {
    "type": "regex",
    "field": "report",
    "pattern": "Reference \\(relaxed\\)|Against the floors|missed floors|floors missed",
    "flags": "i",
    "negate": true
  }
}
