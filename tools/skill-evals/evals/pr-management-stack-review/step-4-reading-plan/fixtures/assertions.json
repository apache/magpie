{
  "note_has_sampled_tag": {
    "type": "regex",
    "field": "note_for_sampled_layer",
    "pattern": "\\[C sampled\\]"
  },
  "note_avoids_forbidden_wording": {
    "type": "regex",
    "field": "note_for_sampled_layer",
    "pattern": "^(?!.*\\b(reviewed|approved|looks good|no issues found)\\b).*$",
    "flags": "is"
  },
  "coverage_mentions_counts": {
    "type": "regex",
    "field": "coverage_sentence",
    "pattern": "15 of 65|109"
  },
  "coverage_avoids_forbidden_wording": {
    "type": "regex",
    "field": "coverage_sentence",
    "pattern": "^(?!.*\\b(reviewed|approved|looks good|no issues found)\\b).*$",
    "flags": "is"
  }
}
