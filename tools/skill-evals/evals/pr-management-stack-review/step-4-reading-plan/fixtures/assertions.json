{
  "has_sampled_tag_in_note": {
    "type": "regex",
    "field": "note_for_sampled_layer",
    "pattern": "\\[C sampled\\]"
  },
  "has_no_forbidden_wording_in_note": {
    "type": "regex",
    "field": "note_for_sampled_layer",
    "pattern": "^(?!.*\\b(reviewed|approved|looks good|no issues found)\\b).*$",
    "flags": "is"
  },
  "has_outlier_count_in_coverage": {
    "type": "regex",
    "field": "coverage_sentence",
    "pattern": "\\b15\\D{0,40}\\b65\\b"
  },
  "has_unread_hunk_count_in_coverage": {
    "type": "regex",
    "field": "coverage_sentence",
    "pattern": "\\b109\\b"
  },
  "has_no_forbidden_wording_in_coverage": {
    "type": "regex",
    "field": "coverage_sentence",
    "pattern": "^(?!.*\\b(reviewed|approved|looks good|no issues found)\\b).*$",
    "flags": "is"
  }
}
